    {
      "name": "6. Admin Panel (Role admin-kampus / super-admin)",
      "item": [
        {
          "name": "Get System Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/stats",
              "host": ["{{base_url}}"],
              "path": ["admin", "stats"]
            }
          }
        },
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/users?account_type=&search=",
              "host": ["{{base_url}}"],
              "path": ["admin", "users"],
              "query": [
                {
                  "key": "account_type",
                  "value": "academic",
                  "description": "Filter by academic atau public"
                },
                {
                  "key": "search",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Suspend / Unsuspend User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/users/1/suspend",
              "host": ["{{base_url}}"],
              "path": ["admin", "users", "1", "suspend"]
            }
          }
        },
        {
          "name": "Override User Quota",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quota_bytes\": 10737418240\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/users/1/quota",
              "host": ["{{base_url}}"],
              "path": ["admin", "users", "1", "quota"]
            }
          }
        },
        {
          "name": "View System Activity Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/logs?action=&user_id=",
              "host": ["{{base_url}}"],
              "path": ["admin", "logs"]
            }
          }
