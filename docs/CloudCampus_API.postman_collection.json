{
  "info": {
    "_postman_id": "c7a8e0f9-3d21-4f1b-9a84-cloudcampus-api",
    "name": "CloudCampus Storage API (v1)",
    "description": "Koleksi Postman untuk endpoint REST API CloudCampus Storage v1, termasuk integrasi Sistem Akademik dan autentikasi Laravel Sanctum.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_SANCTUM_BEARER_TOKEN",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Autentikasi & Akun",
      "item": [
        {
          "name": "Get Authenticated User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://127.0.0.1:8000/api/user",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "user"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Folders",
      "item": [
        {
          "name": "List Folders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/folders?parent_id=",
              "host": ["{{base_url}}"],
              "path": ["folders"],
              "query": [
                {
                  "key": "parent_id",
                  "value": "",
                  "description": "Kosongkan untuk root folder atau isi ID folder induk"
                }
              ]
            }
          }
        },
        {
          "name": "Create Folder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tugas Kuliah Web 2026\",\n  \"parent_id\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/folders",
              "host": ["{{base_url}}"],
              "path": ["folders"]
            }
          }
        },
        {
          "name": "Get Folder Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/folders/1",
              "host": ["{{base_url}}"],
              "path": ["folders", "1"]
            }
          }
        },
        {
          "name": "Rename Folder",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tugas Kuliah Web 2026 - Revisi\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/folders/1",
              "host": ["{{base_url}}"],
              "path": ["folders", "1"]
            }
          }
        },
        {
          "name": "Move Folder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parent_id\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/folders/1/move",
              "host": ["{{base_url}}"],
              "path": ["folders", "1", "move"]
            }
          }
        },
        {
          "name": "Download Folder as ZIP",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/folders/1/download",
              "host": ["{{base_url}}"],
              "path": ["folders", "1", "download"]
            }
          }
        },
        {
          "name": "Delete Folder",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/folders/1",
              "host": ["{{base_url}}"],
              "path": ["folders", "1"]
            }
          }
        }
      ]
    },
    {
