      "item": [
        {
          "name": "List Files",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/files?folder_id=&search=",
              "host": ["{{base_url}}"],
              "path": ["files"],
              "query": [
                {
                  "key": "folder_id",
                  "value": "",
                  "description": "Filter ID folder (kosong untuk root)"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Pencarian nama berkas"
                }
              ]
            }
          }
        },
        {
          "name": "Upload File (User Mandiri)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "folder_id",
                  "value": "",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/files",
              "host": ["{{base_url}}"],
              "path": ["files"]
            }
          }
        },
