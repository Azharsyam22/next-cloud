                {
                  "key": "folder_id",
                  "value": "",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/files",
              "host": ["{{base_url}}"],
              "path": ["files"]
            }
          }
        },
        {
          "name": "Get File Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/files/1",
              "host": ["{{base_url}}"],
              "path": ["files", "1"]
            }
          }
        },
        {
          "name": "Rename File",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"berkas_skripsi_final_rev2.pdf\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/files/1",
              "host": ["{{base_url}}"],
              "path": ["files", "1"]
            }
          }
        },
        {
          "name": "Move File",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"folder_id\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/files/1/move",
              "host": ["{{base_url}}"],
              "path": ["files", "1", "move"]
            }
          }
        },
        {
          "name": "Download File Stream",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/files/1/download",
              "host": ["{{base_url}}"],
              "path": ["files", "1", "download"]
            }
          }
        },
        {
          "name": "Delete File (Pindah ke Trash)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/files/1",
              "host": ["{{base_url}}"],
              "path": ["files", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Shares & Kolaborasi",
      "item": [
        {
          "name": "List User Shares",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/shares",
              "host": ["{{base_url}}"],
              "path": ["shares"]
            }
          }
        },
        {
          "name": "Create Public Share Link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shareable_type\": \"file\",\n  \"shareable_id\": 1,\n  \"permission\": \"download\",\n  \"expires_in_days\": 7\n}"
            },
            "url": {
              "raw": "{{base_url}}/shares",
              "host": ["{{base_url}}"],
              "path": ["shares"]
            }
          }
        },
        {
          "name": "Create Private Share (Ke Pengguna Lain)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shareable_type\": \"folder\",\n  \"shareable_id\": 1,\n  \"permission\": \"view\",\n  \"email\": \"dosen.pembimbing@kampus.ac.id\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/shares",
              "host": ["{{base_url}}"],
              "path": ["shares"]
            }
          }
        },
        {
          "name": "Revoke / Delete Share",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/shares/1",
              "host": ["{{base_url}}"],
              "path": ["shares", "1"]
            }
          }
        },
        {
          "name": "Public Access Share Info (Tanpa Auth)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/public/shares/YOUR_64_CHAR_TOKEN",
              "host": ["{{base_url}}"],
              "path": ["public", "shares", "YOUR_64_CHAR_TOKEN"]
            }
          }
        },
        {
          "name": "Public Download via Share Token (Tanpa Auth)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/public/shares/YOUR_64_CHAR_TOKEN/download",
              "host": ["{{base_url}}"],
              "path": ["public", "shares", "YOUR_64_CHAR_TOKEN", "download"]
